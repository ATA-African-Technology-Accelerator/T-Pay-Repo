{
  "name": "t-pay",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend/web-prototype"
  ],
  "scripts": {
    "dev": "npm run dev -w @tpay/web-prototype",
    "build": "npm run build -w @tpay/web-prototype",
    "backend:start": "npm start -w @tpay/backend",
    "dev:full": "concurrently \"npm run dev\" \"npm run backend:start\"",
    "lint": "tsc --noEmit -p shared && tsc --noEmit -p backend && tsc --noEmit -p frontend/web-prototype",
    "test:domain": "npm run test:domain -w @tpay/shared",
    "docs:pdf": "node scripts/build-docs-pdf.mjs",
    "docs:verify": "node scripts/verify-docs-pdf.mjs",
    "docs:docx": "node scripts/build-docs-docx.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "docx": "^9.15.2",
    "marked": "^18.1.3",
    "typescript": "^7.0.2"
  }
}
