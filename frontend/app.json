{
  "expo": {
    "name": "T-Pay",
    "slug": "tpay-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#B3EE4A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tpay.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#B3EE4A"
      },
      "package": "com.tpay.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-asset"
    ]
  }
}
