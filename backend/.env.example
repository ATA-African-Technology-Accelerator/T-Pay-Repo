# Local Postgres from docker-compose.yml. Use the Render connection string when deployed.
DATABASE_URL=postgres://tpay:tpay@localhost:5433/tpay

# Create both with: npm run keys:root
ROOT_PRIVATE_KEY=
ROOT_PUBLIC_KEY=

PORT=4000

# PayPal sandbox app credentials: developer.paypal.com > Apps & Credentials
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# Address PayPal sends the person back to. Use the Render URL when deployed.
PUBLIC_BASE_URL=http://localhost:4000

# Fixed demo rate, naira per US dollar.
FX_RATE=1500.00
