{
  "name": "tpay-backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc --noEmit -p . && tsc --noEmit -p ../shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "keys:root": "tsx scripts/generateRootKey.ts",
    "paypal:proof": "tsx scripts/paypalProof.ts",
    "db:up": "docker compose up -d --wait",
    "db:migrate": "tsx scripts/migrate.ts",
    "test:db": "TEST_DATABASE_URL=postgres://tpay:tpay@localhost:5433/tpay vitest run && npm run test:api:db",
    "test:api:db": "API_STORAGE=postgres TEST_DATABASE_URL=postgres://tpay:tpay@localhost:5433/tpay vitest run tests/http"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tpay/shared": "file:../shared",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "tsx": "^4.21.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "fast-check": "^4.10.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
